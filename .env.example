# copie para .env e ajuste
# Senha do painel: mínimo 12 caracteres (o servidor não inicia com uma senha fraca/de exemplo)
ADMIN_PASSWORD=troque-esta-senha
PORT=3000
# use um e-mail real seu (exigido pelos serviços de push)
VAPID_SUBJECT=mailto:voce@seudominio.com
# URL pública do servidor (https). OBRIGATÓRIA em produção: os links rastreáveis e os envios agendados dependem dela.
BASE_URL=

# Chaves VAPID. RECOMENDADO em produção: defina aqui (gere uma vez com: npx web-push generate-vapid-keys).
# Em branco = gera e guarda em data/vapid.json (permissão 0600). NUNCA troque as chaves depois de ter inscritos.
VAPID_PUBLIC=
VAPID_PRIVATE=

# Pasta dos dados (banco SQLite, uploads, chaves). Aponte para um DISCO PERSISTENTE na hospedagem.
DATA_DIR=
# Quantos proxies existem na frente do servidor (para o IP real no limite de tentativas). 1 = um proxy (Render, Railway, Nginx...). 0 = acesso direto.
TRUST_PROXY=1
# Limite de inscrições ativas
MAX_SUBSCRIBERS=500000
# Domínios extras de serviços push aceitos (separados por vírgula), além de Google, Mozilla, Apple e Microsoft
PUSH_ENDPOINT_ALLOW=
